{
  "agent": "autonomous",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Bash"],
    "deny": ["AskUserQuestion"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/ianqchan/.claude/profiles/guard.py autonomous",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
